RewriteEngine On

# 啟用重寫模組
<IfModule mod_rewrite.c>
    # 處理 /portfolio/api/ 請求 - 重定向到實際的 API 路徑
    RewriteCond %{REQUEST_URI} ^/portfolio/api/
    RewriteRule ^portfolio/api/(.*)$ api/$1 [L,QSA]
    
    # 處理所有 API 請求
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^api/(.*)$ api/index.php?path=$1 [L,QSA]
</IfModule>

# 設定 API 路由（這些規則現在不會執行，因為上面的規則已經捕獲了所有 API 請求）
# RewriteRule ^api/?$ api/index.php [L]
# RewriteRule ^api/student/auth/?$ api/student/auth.php [L]
# RewriteRule ^api/student/profile/?$ api/student/profile.php [L]
# RewriteRule ^api/student/portfolio/?$ api/student/portfolio.php [L]
# RewriteRule ^api/student/resume/?$ api/student/resume.php [L]

# 通用 API（這些規則現在不會執行，因為上面的規則已經捕獲了所有 API 請求）
# RewriteRule ^api/search/?$ api/index.php?path=search [L,QSA]
# RewriteRule ^api/categories/?$ api/index.php?path=categories [L,QSA]
# RewriteRule ^api/upload/?$ api/index.php?path=upload [L,QSA]

# 處理前端路由（SPA 支援）
# 注意：靜態檔案（CSS、JS、圖片）優先處理
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/portfolio/api/
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$
RewriteRule ^(.*)$ frontend/index.html [L]

# 安全性設定
<Files "*.env">
    Order allow,deny
    Deny from all
</Files>

<Files "*.sql">
    Order allow,deny
    Deny from all
</Files>

# 設定 CORS 標頭
Header always set Access-Control-Allow-Origin "*"
Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-User-ID"

# 處理 OPTIONS 請求
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# 壓縮設定
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# 快取設定
<IfModule mod_expires.c>
    ExpiresActive on
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
</IfModule> 