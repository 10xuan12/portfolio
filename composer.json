{
    "name": "portfolio/eportfolio-system",
    "description": "學生作品集管理系統",
    "type": "project",
    "require": {
        "php": ">=7.3",
        "mpdf/mpdf": "^8.2",
        "dompdf/dompdf": "^3.1",
        "vlucas/phpdotenv": "^5.6",
        "cloudinary/cloudinary_php": "^2.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('env.example.txt', '.env');\""
        ]
    }
}
