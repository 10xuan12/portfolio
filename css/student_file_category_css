.sidebar {
    width: 220px;
    min-height: 100vh;
}

.main-content {
    background-color: #f8f9fa;
}

.card-img-top {
    object-fit: cover;
    height: 150px;
    border-radius: 0.5rem 0.5rem 0 0;
}

.card {
    border-radius: 0.5rem;
}

.card .btn {
    transition: transform 0.2s ease;
}

.card .btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 5px 10px rgba(99, 132, 255, 0.3);
}


#search {
    padding-left: 2.5rem;
}

.bi-search {
    font-size: 1.2rem;
}
